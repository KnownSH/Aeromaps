---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import type { Session } from "@auth/core/types";
import { Avatar } from "@mui/material";
import { getSession } from "auth-astro/server";

export interface SessionDiscord extends Session {
  guilds?: any;
}

const session: SessionDiscord | null = await getSession(Astro.request);

export function inServer(session: SessionDiscord) {
  if (session?.user && session.user.guilds !== null && typeof session.user.guilds[Symbol.iterator] === "function") {
    for (const guild of session.user.guilds) {
      if (guild.id === "1327648551718621284") {
        return true;
      }
    }
    return false;
  }
}

const validAccount = inServer(session);
---

<Layout>
  <section class="center p-3 rounded-md border-white border">
    <div class="mb-2">
      <button id="login">Login</button> : <button id="logout">Logout</button>
    </div>
    <script>
      const { signIn, signOut } = await import("auth-astro/client");
      document.querySelector("#login").onclick = () => signIn("discord");
      document.querySelector("#logout").onclick = () => signOut();
    </script>
    {
      session ? (
        <img class="rounded-[50%] max-h-8" alt="discord pfp" src={session.user?.image}/>
        <p>You are logged in as: {session.user?.name}</p>
      ) : (
        <p>Not logged in</p>
      )
    }
    {
      validAccount && session ? (
        <p>You are in the Aeromaps Discord server</p>
      ) : (
        <span>
          <p>You must join the <a href="https://discord.gg/dfQRWqhvEM">Aeromaps Discord Server</a> to submit data</p>
          <small>This is to prevent webhook abuse</small>
        </span>
      )
    }
    <br />
    <section>
      <a href=""
        >Submit Airport Data [CURRENTLY BROKEN] {validAccount ? "" : "[Server Verification Required]"}</a
      >
    </section>
  </section>
</Layout>

<style>
  button {
    font-family: "Jetbrains Mono", sans-serif;
    border: 1px white solid;
    border-radius: 0.2rem;
    padding: 3px;
  }

  p,
  a {
    font-family: "Jetbrains Mono", sans-serif;
  }

  button:hover,
  a:hover {
    background-color: white;
    color: black;
  }

  a {
    background-color: white;
    color: black;
  }

  a:hover {
    background-color: black;
    color: teal;
  }

  .center {
    position: absolute;
    top: 50%;
    left: 50%;
    margin-right: -50%;
    transform: translate(-50%, -50%);
  }
</style>
